{
  "name": "sd-alert-server",
  "version": "0.1.0",
  "private": true,
  "description": "Internal alert notification server. Receives alerts from /billing and /sd, persists them, and fans out to mobile devices via FCM v1.",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "migrate:make": "knex migrate:make",
    "migrate:latest": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "lint": "eslint src --ext .ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/jwt": "^9.0.1",
    "dotenv": "^16.4.5",
    "fastify": "^5.0.0",
    "google-auth-library": "^9.14.0",
    "knex": "^3.1.0",
    "mysql2": "^3.11.3",
    "pino-pretty": "^11.2.2"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
